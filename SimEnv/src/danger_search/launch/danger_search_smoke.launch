<launch>
  <!--
    短超时自检入口：用于验证节点能启动、发布安全停止、超时写出结果文件。
    不依赖 Gazebo 传感器必须在线，也不读取裁判真值。
  -->
  <arg name="config" default="$(find danger_search)/config/danger_search.yaml"/>
  <arg name="result_file" default="/tmp/danger_search_smoke_detected.json"/>
  <arg name="mission_summary_file" default="/tmp/danger_search_smoke_summary.json"/>
  <arg name="max_runtime" default="3.0"/>

  <param name="/use_sim_time" value="false"/>
  <rosparam command="load" file="$(arg config)"/>

  <!-- 仅诊断：缺少公开场景文件时使用相对原点，不能作为正式评分运行。 -->
  <include file="$(find danger_search_localization)/launch/scan_localization.launch">
    <arg name="require_team_scene_info" value="false"/>
    <arg name="allow_relative_origin" value="true"/>
  </include>

  <node pkg="danger_search"
        type="danger_search_node"
        name="danger_search_smoke"
        required="true"
        output="screen">
    <param name="mission/max_runtime" value="$(arg max_runtime)"/>
    <param name="runtime/profile" value="diagnostic"/>
    <param name="wait_for_localization_ready" value="false"/>
    <param name="localization/stance_health_required" value="false"/>
    <param name="localization/global_frame_id" value="danger_search_relative"/>
    <param name="mission/max_floor" value="1"/>
    <param name="result_file" value="$(arg result_file)"/>
    <param name="mission_summary_file" value="$(arg mission_summary_file)"/>
    <param name="localization/require_team_scene_info" value="false"/>
    <param name="localization/allow_relative_origin" value="true"/>
  </node>
</launch>
