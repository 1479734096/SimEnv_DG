<launch>
  <!--
    正式生产入口。启动顺序由 ROS 自动协调：先加载统一参数，再启动合法传感器
    定位节点，最后启动 Python 主状态机。定位节点 required=true，退出会终止
    整个 launch；主节点同样 required=true，防止失去控制后仿真继续运行。
  -->
  <arg name="config" default="$(find danger_search)/config/danger_search.yaml"/>
  <arg name="result_file" default=""/>
  <arg name="mission_summary_file" default=""/>
  <arg name="localization_diagnostic_frame_details" default="false"/>
  <!-- 仅允许定位节点自身白名单中的后端；正式默认保持 rgbd_livox。 -->
  <arg name="localization_backend" default="rgbd_livox"/>

  <!-- 参数加载到全局命名空间；MissionManager 只读取并分组，不允许子组件私取配置。 -->
  <rosparam command="load" file="$(arg config)"/>

  <include file="$(find danger_search_localization)/launch/scan_localization.launch">
    <!-- 正式后端只使用公开 /scan、深度点云、/trunk_imu 和自身控制先验。 -->
    <arg name="localization_backend" value="$(arg localization_backend)"/>
    <arg name="stance_health_enabled" value="true"/>
    <arg name="team_scene_info_path"
         value="$(find danger_search)/../../generated_building/team_scene_info.json"/>
    <arg name="require_team_scene_info" value="true"/>
    <arg name="allow_relative_origin" value="false"/>
    <arg name="diagnostic_frame_details"
         value="$(arg localization_diagnostic_frame_details)"/>
  </include>

  <node pkg="danger_search"
        type="danger_search_node"
        name="danger_search"
        required="true"
        output="screen">
    <!-- formal 强制公开 schema/接口校验，并禁用相对原点、手动目标和真值回退。 -->
    <param name="runtime/profile" value="formal"/>
    <param name="wait_for_localization_ready" value="true"/>
    <param name="result_file" value="$(arg result_file)"/>
    <param name="mission_summary_file" value="$(arg mission_summary_file)"/>
    <param name="localization/team_scene_info_path"
           value="$(find danger_search)/../../generated_building/team_scene_info.json"/>
  </node>
</launch>
