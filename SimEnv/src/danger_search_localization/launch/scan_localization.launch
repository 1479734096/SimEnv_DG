<launch>
  <!--
    定位子系统入口。外部输入只允许 /scan、/real_sense/depth/points、
    /trunk_imu 和本算法自己的 /cmd_vel；输出全部位于 /danger_search/localization。
    正式父 launch 默认选择 adaptive_shared_map；本文件的默认 kiss_icp 仅保留
    独立诊断兼容，正式运行由父 launch 显式传入后端。
  -->
  <arg name="raw_cloud_topic" default="/scan"/>
  <arg name="depth_cloud_topic" default="/real_sense/depth/points"/>
  <arg name="raw_cloud_frame" default="laser_livox"/>
  <arg name="imu_frame" default="imu_link"/>
  <arg name="depth_cloud_frame" default="real_sense_optical_frame"/>
  <arg name="localization_backend" default="kiss_icp"/>
  <arg name="max_range" default="15.0"/>
  <arg name="adaptive_rgbd_localization_enabled" default="false"/>
  <arg name="team_scene_info_path" default="$(find danger_search)/../../generated_building/team_scene_info.json"/>
  <arg name="require_team_scene_info" default="true"/>
  <arg name="allow_relative_origin" default="false"/>
  <arg name="initialization_min_base_height" default="0.20"/>
  <arg name="initialization_max_base_height" default="0.55"/>
  <arg name="initialization_stable_frames" default="8"/>
  <arg name="stance_health_enabled" default="true"/>
  <!-- 允许经过约 7.5 cm 门槛时楼面距离短暂降低；趴地约 0.058 m 仍会被拒绝。 -->
  <arg name="health_min_base_height" default="0.14"/>
  <arg name="health_max_base_height" default="0.60"/>
  <arg name="health_min_ground_normal_z" default="0.85"/>
  <arg name="health_min_base_up_z" default="0.71"/>
  <!-- 不得低于正式控制器正常角速度包络，避免正常转弯被判成跌倒。 -->
  <arg name="health_max_angular_speed" default="1.50"/>
  <arg name="health_required_healthy_frames" default="8"/>
  <arg name="health_required_unhealthy_frames" default="3"/>
  <arg name="health_required_unknown_frames" default="30"/>
  <arg name="health_latch_unhealthy" default="true"/>
  <!-- scan-to-map 是慢漂校正层，不允许一次匹配直接注入旧 0.25 m 上限。 -->
  <arg name="scan_to_map_maximum_correction" default="0.10"/>
  <!-- 候选后端按控制器速度包络拒绝不可信跳变；拒绝帧不写入局部地图。 -->
  <arg name="livox_imu_maximum_speed" default="0.70"/>
  <arg name="livox_imu_translation_margin" default="0.02"/>
  <arg name="livox_imu_absolute_translation_cap" default="0.30"/>
  <!-- RGB-D 失效时按正式输出间隔收紧 Livox-only 运动学上限。 -->
  <arg name="shared_map_livox_only_maximum_speed" default="0.60"/>
  <!-- 连续第三次后置否决时交回通用运动学守卫裁决，避免冻结正式位姿。 -->
  <arg name="shared_map_livox_only_max_consecutive_vetoes" default="3"/>
  <!-- 共享地图候选只按实时测量有效性选源，不读取任务阶段。 -->
  <arg name="shared_map_depth_max_age" default="0.35"/>
  <arg name="shared_map_max_source_divergence" default="0.05"/>
  <arg name="shared_map_max_map_commit_difference" default="0.05"/>
  <!-- 逐帧质量日志仅用于隔离诊断，正式启动默认关闭。 -->
  <arg name="diagnostic_frame_details" default="false"/>

  <node pkg="danger_search_localization"
        type="scan_localization_node"
        name="scan_localization"
        required="true"
        output="screen">
    <!-- C++ 构造函数还会再次检查话题固定值和公开场景 allowed_interfaces。 -->
    <param name="raw_cloud_topic" value="$(arg raw_cloud_topic)"/>
    <param name="depth_cloud_topic" value="$(arg depth_cloud_topic)"/>
    <param name="raw_cloud_frame" value="$(arg raw_cloud_frame)"/>
    <param name="imu_frame" value="$(arg imu_frame)"/>
    <param name="depth_cloud_frame" value="$(arg depth_cloud_frame)"/>
    <param name="localization_backend" value="$(arg localization_backend)"/>
    <param name="adaptive_rgbd_localization_enabled"
           value="$(arg adaptive_rgbd_localization_enabled)"/>
    <param name="team_scene_info_path" value="$(arg team_scene_info_path)"/>
    <param name="require_team_scene_info" value="$(arg require_team_scene_info)"/>
    <param name="allow_relative_origin" value="$(arg allow_relative_origin)"/>
    <!-- 腹部着地时楼面法向仍可能合法；以连续站立高度窗口阻止错误世界系。 -->
    <param name="initialization_min_base_height"
           value="$(arg initialization_min_base_height)"/>
    <param name="initialization_max_base_height"
           value="$(arg initialization_max_base_height)"/>
    <param name="initialization_stable_frames"
           value="$(arg initialization_stable_frames)"/>
    <param name="initialization_max_height_span" value="0.04"/>
    <param name="initialization_max_angular_speed" value="0.30"/>
    <!-- 速度按一秒位姿窗口估计，避免静止配准抖动被 10 Hz 差分放大。 -->
    <param name="velocity_estimation_window" value="1.00"/>
    <param name="velocity_minimum_interval" value="0.80"/>
    <param name="velocity_linear_deadband" value="0.05"/>
    <param name="velocity_angular_deadband" value="0.03"/>
    <!-- 诊断只记录既有验收分支和稀疏异常，不改变融合验收或校正。 -->
    <param name="diagnostic_large_translation_threshold" value="0.08"/>
    <param name="diagnostic_summary_period" value="2.0"/>
    <param name="scan_to_map_maximum_correction"
           value="$(arg scan_to_map_maximum_correction)"/>
    <param name="livox_imu_maximum_speed"
           value="$(arg livox_imu_maximum_speed)"/>
    <param name="livox_imu_translation_margin"
           value="$(arg livox_imu_translation_margin)"/>
    <param name="livox_imu_absolute_translation_cap"
           value="$(arg livox_imu_absolute_translation_cap)"/>
    <param name="shared_map_livox_only_maximum_speed"
           value="$(arg shared_map_livox_only_maximum_speed)"/>
    <param name="shared_map_livox_only_max_consecutive_vetoes"
           value="$(arg shared_map_livox_only_max_consecutive_vetoes)"/>
    <param name="shared_map_depth_max_age"
           value="$(arg shared_map_depth_max_age)"/>
    <param name="shared_map_max_source_divergence"
           value="$(arg shared_map_max_source_divergence)"/>
    <param name="shared_map_max_map_commit_difference"
           value="$(arg shared_map_max_map_commit_difference)"/>
    <param name="diagnostic_frame_details"
           value="$(arg diagnostic_frame_details)"/>
    <!-- 世界系建立后的持续姿态健康监控；只用 /scan 与 /trunk_imu。 -->
    <param name="stance_health_enabled" value="$(arg stance_health_enabled)"/>
    <param name="health_min_base_height" value="$(arg health_min_base_height)"/>
    <param name="health_max_base_height" value="$(arg health_max_base_height)"/>
    <param name="health_min_ground_normal_z"
           value="$(arg health_min_ground_normal_z)"/>
    <param name="health_min_base_up_z" value="$(arg health_min_base_up_z)"/>
    <param name="health_max_angular_speed"
           value="$(arg health_max_angular_speed)"/>
    <param name="health_required_healthy_frames"
           value="$(arg health_required_healthy_frames)"/>
    <param name="health_required_unhealthy_frames"
           value="$(arg health_required_unhealthy_frames)"/>
    <param name="health_required_unknown_frames"
           value="$(arg health_required_unknown_frames)"/>
    <param name="health_latch_unhealthy" value="$(arg health_latch_unhealthy)"/>
    <param name="min_range" value="0.5"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="voxel_size" value="0.15"/>
    <!-- 控制先验只用于点云退化方向的 GICP 初值，可由后续实测替换。 -->
    <param name="command_velocity_scale" value="1.0"/>
    <!-- 固定外参来自公开传感器安装说明，不在运行时查询可能含真值的 TF 链。 -->
    <rosparam param="base_to_livox_xyz">[0.2, 0.0, 0.08]</rosparam>
    <rosparam param="base_to_livox_rpy">[0.0, 0.785, 0.0]</rosparam>
    <rosparam param="base_to_depth_xyz">[0.28, 0.0, 0.043]</rosparam>
    <rosparam param="base_to_depth_rpy">[-1.57079632679, 0.0, -1.57079632679]</rosparam>
  </node>
</launch>
